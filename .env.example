MARITIME_DATA_DIR=data
# Auth is required for all endpoints except health. Generate your own keys.
MARITIME_API_KEY=
MARITIME_OPERATOR_KEY=
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Production Azure architecture; empty values are never treated as successful setup.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Prefer managed identity; optional API key or Key Vault secret name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_KEY_SECRET=
AZURE_KEY_VAULT_URL=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_SERVING_CONTAINER=maritime-serving
AZURE_AUDIT_CONTAINER=maritime-audit
FABRIC_PREDICTION_NOTEBOOK_ID=
AZURE_API_AUDIENCE=
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Local: key/sqlite. Production: entra/azure_blob.
MARITIME_AUTH_MODE=key
MARITIME_STORAGE_BACKEND=sqlite
# Isolated Compose demo binds loopback only; choose a free local port.
MARITIME_DEMO_PORT=18081
# Bounds are validated at startup; these are limits, not performance guarantees.
MARITIME_MAX_BODY_BYTES=65536
MARITIME_MAX_CONCURRENCY=64
